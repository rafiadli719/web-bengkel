# Base API endpoint
SYNC_API_BASE_URL=http://localhost/web-bengkel/aplikasi/aplikasi/api/sync

# Must match config/access_sync_env.php
SYNC_API_TOKEN=FITMOTOR_SYNC_CHANGE_THIS_TOKEN_2026

# Source Access MDB
SYNC_MDB_PATH=E:\BENGKEL 2.0\FITMOTOR GABUNG.mdb

# Sync behavior
SYNC_MODE=incremental
SYNC_BATCH_SIZE=50
SYNC_CURSOR_FETCH_SIZE=100
SYNC_HTTP_TIMEOUT=120

# Runtime directories
SYNC_LOG_DIR=C:\laragon\www\web-bengkel\aplikasi\aplikasi\tools\access_sync_client\logs
SYNC_RUNTIME_DIR=C:\laragon\www\web-bengkel\aplikasi\aplikasi\tools\access_sync_client\runtime
SYNC_STATE_DB_PATH=C:\laragon\www\web-bengkel\aplikasi\aplikasi\tools\access_sync_client\runtime\sync_state.sqlite3
SYNC_LOCK_FILE_PATH=C:\laragon\www\web-bengkel\aplikasi\aplikasi\tools\access_sync_client\runtime\sync.lock

# Optional fallback cabang when dataset row has no branch source
SYNC_DEFAULT_SOURCE_CABANG=PST
